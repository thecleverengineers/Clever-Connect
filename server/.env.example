NODE_ENV=development
PORT=5000
MONGODB_HOST=your-cluster.mongodb.net
MONGODB_USER=clever_connect_app
MONGODB_PASSWORD=replace-with-database-password
# Optional legacy alternative:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/clever_connect?retryWrites=true&w=majority
AUTH_KEY=replace-with-strong-session-key
CLIENT_URL=http://localhost:5173
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
META_WEBHOOK_VERIFY_TOKEN=replace-with-webhook-verification-token

# Meta Facebook Embedded Signup (server-side; never expose META_APP_SECRET in the browser)
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_EMBEDDED_SIGNUP_CONFIG_ID=replace-with-facebook-login-for-business-config-id
META_GRAPH_VERSION=v23.0

# Optional fallback for WA SANTA AI. Prefer configuring these in Super Admin.
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-6-luna
OPENAI_STRATEGY_MODEL=gpt-6-sol
